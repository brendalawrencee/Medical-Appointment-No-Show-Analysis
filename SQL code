-- Data Exploration
-- 1: What's the overall no-show rate?

SELECT * FROM medicalappointments
LIMIT 10;

SELECT 
	no_show,
    COUNT(*) as total_appointments,
    ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM medicalappointments), 2) as pct_of_total
FROM medicalappointments
GROUP BY no_show;



-- 2: Does the day of the week matter?
SELECT 
	DAYNAME(AppointmentDay) as appointment_day,
    COUNT(*) as total_appointments, -- total number of appointments for each day
    SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) as no_shows,
    ROUND(SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) as rate_of_no_shows
FROM medicalappointments
GROUP BY DAYNAME(AppointmentDay)
ORDER BY rate_of_no_shows DESC;


-- 2: Does lead time matter?

-- Same day
-- 1-3 days
-- within a week (4-7 days)
-- Long lead (8+ days)

SELECT 
	CASE 
		WHEN lead_time_days = 0 THEN 'Same Day'
		WHEN lead_time_days BETWEEN 1 AND 3 THEN 'Short (1-3 Days)'
		WHEN lead_time_days BETWEEN 4 AND 7 THEN 'Within a week'
        ELSE 'Long Lead (8+ days)'
	END as lead_time_bucket,
	COUNT(*) as total_appointments,
    ROUND(SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) * 100 / COUNT(*), 2) as no_show_rate
FROM medicalappointments
GROUP BY lead_time_bucket
ORDER BY no_show_rate DESC;
  
-- Long lead (8+ days) exploration
SELECT 
	CASE 
        WHEN lead_time_days BETWEEN 8 AND 25 THEN '8 - 25 days'
        WHEN lead_time_days BETWEEN 26 AND 50 THEN '26 - 50 days'
		WHEN lead_time_days BETWEEN 51 AND 75 THEN '51 - 75 days'
        WHEN lead_time_days BETWEEN 76 AND 100 THEN '76 - 100 days'
        WHEN lead_time_days BETWEEN 101 AND 125 THEN '101 - 125 days'
        WHEN lead_time_days BETWEEN 126 AND 150 THEN '126 - 150 days'
        ELSE '151+ days'
        
	END as lead_time_bucket,
	COUNT(*) as total_appointments,
    ROUND(SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) * 100 / COUNT(*), 2) as no_show_rate
FROM medicalappointments
GROUP BY lead_time_bucket
ORDER BY no_show_rate DESC;

       
-- 4: Differentiation between age groups?

-- child (0-12)
-- teen (13-19)
-- young adult (20-39)
-- adult (40-59)

SELECT
	CASE
		WHEN Age BETWEEN 0 AND 12 THEN 'Child (0-12 yrs old'
		WHEN Age BETWEEN 13 AND 19 THEN 'Teen (13-19 yrs old)'
        WHEN Age BETWEEN 20 AND 39 THEN 'Young Adult (20-39 yrs old)'
        WHEN Age BETWEEN 40 AND 59 THEN 'Adult Young Adult (40-59 yrs old)'
		ELSE 'Senior (60+)'
	END as age_group,
    COUNT(*) as total_appointments,
    ROUND(SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) * 100 / COUNT(*), 2) as no_show_rate
FROM medicalappointments
GROUP BY age_group
ORDER BY no_show_rate DESC;


-- 5: Do SMS reminders help?
SELECT
	CASE WHEN SMS_received = 1 THEN 'Received SMS' ELSE 'No SMS' END as sms_status,
    COUNT(*) as total_appointments,
    ROUND(SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) * 100 / COUNT(*), 2) as no_show_rate
FROM medicalappointments
GROUP BY sms_status
ORDER BY no_show_rate DESC;


-- 6: Does the relationship between SMS reminders and no-show rates differ depending on lead time (how far 
-- in advance the appointment was scheduled)?
SELECT 
    CASE 
        WHEN lead_time_days = 0 THEN 'Same Day'
        WHEN lead_time_days BETWEEN 1 AND 3 THEN 'Short (1-3 Days)'
        WHEN lead_time_days BETWEEN 4 AND 7 THEN 'Within a Week'
        ELSE 'Long Lead (8+ Days)'
    END AS lead_time_bucket,
    
    CASE 
		WHEN SMS_received = 1 THEN 'Yes' 
        ELSE 'No' 
	END AS SMS_status,
    
    COUNT(*) AS total_appointments,
    ROUND(SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS no_show_rate
    
FROM medicalappointments
GROUP BY 
    lead_time_bucket, SMS_status
ORDER BY 
    lead_time_bucket, SMS_status;
    
    
-- 7: Which Neighbourhood have the highest no show rates?
SELECT
	Neighbourhood,
    COUNT(*) as total_appointments,
    ROUND(SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) * 100 / COUNT(*), 2) as 
no_show_rate,
	RANK() OVER (ORDER BY ROUND(SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) * 100 / COUNT(*), 2) DESC) as 
risk_rank -- ranking from highest to lowest no show rates
FROM medicalappointments
GROUP BY Neighbourhood
HAVING Count(*) >= 100 -- filtering out neighbourhoods with small number of appointments
ORDER BY no_show_rate DESC
LIMIT 15;
	


-- Creating a patient-level risk scoring based on prior appointment no-shows
SELECT
	patientid,
    appointmentid,
    appointmentday,
    no_show,
    COUNT(*) OVER (
		PARTITION BY PatientId
        ORDER BY AppointmentDay
        ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
	) as prior_appointments,
	SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) OVER 
		(PARTITION BY PatientID
        ORDER BY AppointmentDay
        ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
	) as prior_no_shows
	FROM medicalappointments
    ORDER BY patientid, appointmentday;
    
    
-- Creating a view with each patient's previous appointment history and no-show count
CREATE VIEW v_appointment_risk AS 
WITH patient_history AS (
	SELECT 
		PatientId,
        AppointmentID,
        AppointmentDay,
        Neighbourhood,
        lead_time_days,
        SMS_received,
        Scholarship,
        no_show,
        COUNT(*) OVER (
			PARTITION BY PatientId
			ORDER BY AppointmentDay
			ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
		) as prior_appointments,
		SUM(CASE WHEN no_show = 'Yes' THEN 1 ELSE 0 END) OVER (
			PARTITION BY PatientId
			ORDER BY AppointmentDay
			ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING
		) as prior_no_shows
	FROM medicalappointments
)

-- From view, calculate previous no-show rate for each patient and assign a risk tier
SELECT 
	PatientId,
	AppointmentID,
	AppointmentDay,
	Neighbourhood,
	lead_time_days,
    prior_appointments,
    prior_no_shows,
    ROUND(prior_no_shows / NULLIF(prior_appointments, 0), 2) as prior_no_show_rate,
    -- case sequence stops as soon as one condition is true
    CASE 
		WHEN prior_appointments = 0 THEN 'New Patient - Monitor'
        WHEN (prior_no_shows / NULLIF(prior_appointments, 0)) >= 0.5
			OR lead_time_days >= 8 THEN 'High Risk'
		WHEN (prior_no_shows / NULLIF(prior_appointments, 0)) >= 0.2
			OR lead_time_days BETWEEN 4 AND 7 THEN 'Medium Risk'
		ELSE 'Low Risk'
	END AS risk_tier
FROM patient_history;


-- Checking risk tier filter         
SELECT 
	COUNT(*) as high_risk_appointments
    FROM v_appointment_risk
	WHERE risk_tier = 'High Risk';

SELECT * FROM v_appointment_risk
	WHERE risk_tier = 'High Risk'
	ORDER BY AppointmentDay
	LIMIT 50;

SELECT * FROM v_appointment_risk
	WHERE risk_tier = 'Medium Risk'
	ORDER BY AppointmentDay
	LIMIT 50;

SELECT * FROM v_appointment_risk
	WHERE risk_tier = 'Low Risk'
	ORDER BY AppointmentDay
	LIMIT 50;


